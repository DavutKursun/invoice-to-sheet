# Copy to .env and fill in. Never commit .env. Values may be quoted; an inline " # comment" is ignored.
# A real environment variable always wins over this file.
#
# Space mode: a Hugging Face Space sets SPACE_ID, and then .env is never read (secrets come from the Space
# settings) and the public-demo defaults apply: LLM_PROVIDER=anthropic, ANTHROPIC_MODEL=claude-haiku-5-5,
# MAX_PAGES=20, MAX_DAILY_USD=0.50, MAX_DAILY_DOCS=100, BUDGET_FILE under the temp directory. A variable set
# in the Space settings still wins over those defaults.

# Default: a free OpenAI-compatible provider with a vision model (Groq).
LLM_PROVIDER=openai_compat        # openai_compat | anthropic
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_...
LLM_MODEL=                        # a vision-capable model id from Groq's model list (2026-10-11: qwen/qwen3.8-27b is the only one on the free tier)
USE_JSON_SCHEMA=0                 # 1 = ask the server to enforce the JSON schema. Off by default: Groq's constrained decoder
                                  #     turned Ü/ı/Ş into control characters; JSON mode + Pydantic validation keeps them.

# Optional: Claude (native PDF input, structured outputs). Used when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5   # claude-haiku-5-5 is the measured, cheaper option (and the Space default)

# Document preparation
MAX_PAGES=4                       # pages read per PDF (20 on a Space); longer PDFs are cut and sent to review
RENDER_DPI=150
MAX_IMAGE_SIDE=1568
MAX_FILE_MB=10

# Validation
AMOUNT_TOLERANCE_ABS=0.02
AMOUNT_TOLERANCE_REL=0.01
MIN_CONFIDENCE=0.85

# Output: CSV in OUTPUT_DIR by default; Google Sheets when both of these are set
OUTPUT_DIR=output
SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=      # base64 of the service-account JSON file

# Demo protection: counters for the whole deployment, per UTC day (reset at 00:00 UTC)
MAX_DAILY_USD=2                   # dollars per day (0.50 on a Space)
MAX_DAILY_DOCS=0                  # documents per day, 0 = no cap (100 on a Space)
BUDGET_FILE=.budget.json          # where the counters live (<tmpdir>/invoice-to-sheet/budget.json on a Space)
MAX_FILES_PER_BATCH=10
DOCS_FAKE_EXTRACTOR=0             # 1 = answers copied from data/synthetic/labels.jsonl instead of an LLM (smoke tests only)
